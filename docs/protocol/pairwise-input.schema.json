{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Flova Pairwise Input v1",
  "type": "object",
  "required": [
    "schema_version",
    "comparison_id",
    "baseline_id",
    "candidate_id",
    "frozen_task_rubric_sha256",
    "task_context",
    "comparison_rubric",
    "baseline",
    "candidate"
  ],
  "properties": {
    "schema_version": {
      "const": "flova.pairwise_input.v1"
    },
    "comparison_id": {
      "type": "string"
    },
    "baseline_id": {
      "type": "string"
    },
    "candidate_id": {
      "type": "string"
    },
    "judge_alias": {
      "default": "chat_gemini_pro",
      "type": "string"
    },
    "frozen_task_rubric_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "task_context": {
      "type": "object",
      "required": [
        "query_id",
        "current_instruction",
        "public_history",
        "references"
      ],
      "properties": {
        "query_id": {
          "type": "string"
        },
        "current_instruction": {
          "type": "string"
        },
        "public_history": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false
    },
    "comparison_rubric": {
      "type": "object",
      "required": [
        "schema_version",
        "content_comparison_eligible",
        "criteria"
      ],
      "properties": {
        "schema_version": {
          "const": "flova.pairwise_rubric.v1"
        },
        "content_comparison_eligible": {
          "const": true
        },
        "criteria": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": [
              "criterion_id",
              "statement",
              "weight",
              "source_refs",
              "anchors",
              "required_media",
              "scope"
            ],
            "properties": {
              "criterion_id": {
                "type": "string"
              },
              "statement": {
                "type": "string"
              },
              "weight": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "source_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "message_id",
                    "quote"
                  ],
                  "properties": {
                    "message_id": {
                      "type": "string"
                    },
                    "quote": {
                      "type": "string"
                    }
                  }
                }
              },
              "anchors": {
                "type": "object",
                "required": [
                  "X_better",
                  "Y_better",
                  "equivalent",
                  "insufficient"
                ],
                "properties": {
                  "X_better": {
                    "type": "string"
                  },
                  "Y_better": {
                    "type": "string"
                  },
                  "equivalent": {
                    "type": "string"
                  },
                  "insufficient": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              },
              "required_media": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "scope": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    },
    "baseline": {
      "type": "object",
      "required": [
        "response",
        "artifacts",
        "coverage",
        "media"
      ],
      "properties": {
        "response": {
          "type": "string"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "artifact_id",
              "text"
            ],
            "properties": {
              "artifact_id": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "coverage": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "requirement",
              "available",
              "reason"
            ],
            "properties": {
              "requirement": {
                "type": "string"
              },
              "available": {
                "type": "boolean"
              },
              "reason": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "media": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "asset_id",
              "sha256",
              "local_path",
              "mime_type"
            ],
            "properties": {
              "asset_id": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "local_path": {
                "type": "string"
              },
              "mime_type": {
                "type": "string"
              },
              "duration_seconds": {
                "type": "number",
                "minimum": 0
              },
              "role": {
                "enum": [
                  "result",
                  "input_reference"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": [
        "response",
        "artifacts",
        "coverage",
        "media"
      ],
      "properties": {
        "response": {
          "type": "string"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "artifact_id",
              "text"
            ],
            "properties": {
              "artifact_id": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "coverage": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "requirement",
              "available",
              "reason"
            ],
            "properties": {
              "requirement": {
                "type": "string"
              },
              "available": {
                "type": "boolean"
              },
              "reason": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "media": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "asset_id",
              "sha256",
              "local_path",
              "mime_type"
            ],
            "properties": {
              "asset_id": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "local_path": {
                "type": "string"
              },
              "mime_type": {
                "type": "string"
              },
              "duration_seconds": {
                "type": "number",
                "minimum": 0
              },
              "role": {
                "enum": [
                  "result",
                  "input_reference"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "absolute_evaluation": {
      "type": "object",
      "required": [
        "candidate_id",
        "query_id",
        "acceptance_rubric_sha256",
        "lower",
        "upper",
        "must_failed",
        "eligible",
        "coverage_percent"
      ],
      "properties": {
        "candidate_id": {
          "type": "string"
        },
        "query_id": {
          "type": "string"
        },
        "acceptance_rubric_sha256": {
          "type": "string"
        },
        "lower": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "upper": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "must_failed": {
          "type": "boolean"
        },
        "eligible": {
          "type": "boolean"
        },
        "coverage_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
